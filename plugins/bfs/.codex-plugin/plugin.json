    "shortDescription": "\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f, \u0442\u0435\u043e\u0440\u0435\u043c\u044b, \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438 \u043a\u043e\u043d\u0442\u0440\u043f\u0440\u0438\u043c\u0435\u0440\u044b.",
    "longDescription": "\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a \u043f\u043e BFS: \u0442\u043e\u0447\u043d\u044b\u0435 \u0441\u043b\u043e\u0438, \u043a\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0438\u0435 \u043f\u0443\u0442\u0438, \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0435 \u0448\u0430\u0440\u044b, \u0433\u0440\u0430\u0444\u044b \u041a\u044d\u043b\u0438 \u0438 \u0428\u0440\u0435\u0439\u0435\u0440\u0430, \u0444\u0430\u043a\u0442\u043e\u0440-\u0433\u0440\u0430\u0444\u044b \u0438 \u0442\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432. \u0422\u043e\u043b\u044c\u043a\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0441 \u044f\u0432\u043d\u044b\u043c\u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0441\u044b\u043b\u043a\u0430\u043c\u0438, \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438 \u043a\u043e\u043d\u0442\u0440\u043f\u0440\u0438\u043c\u0435\u0440\u044b.",
    "developerName": "Local developer",
    "category": "Productivity",
    "capabilities": [],
    "defaultPrompt": [
      "\u0414\u043e\u043a\u0430\u0436\u0438, \u0447\u0442\u043e \u0441\u043b\u043e\u0438 BFS \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u044e\u0442 \u0441 \u0443\u0440\u043e\u0432\u043d\u044f\u043c\u0438 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f.",
      "\u0420\u0430\u0437\u0431\u0435\u0440\u0438 \u0442\u0435\u043e\u0440\u0435\u043c\u0443 \u043e \u043f\u0435\u0440\u0432\u043e\u043c \u043f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u0438 \u0432 \u043e\u0431\u0440\u0430\u0442\u043d\u044b\u0439 \u0448\u0430\u0440.",
